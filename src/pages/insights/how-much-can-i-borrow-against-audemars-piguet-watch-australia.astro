            <span class="art-author-role">Principal Valuation Specialist</span>
          </span>
        </div>
        <span class="art-byline-sep" aria-hidden="true"></span>
        <div class="art-dates"><span>14 August 2026</span><span class="meta-sep" aria-hidden="true"></span><span>8 min read</span></div>
      </div>
