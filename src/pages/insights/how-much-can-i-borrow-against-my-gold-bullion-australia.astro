const title = "How much can I borrow against my gold bullion in Australia? | ALYRA";
const description =
  "ALYRA offers gold-bullion loans from $50,000 to $5 million. What you can borrow depends on verified bullion value, collateral quality and lending terms.";
const ogImage = "/assets/og-gold-bullion-loan.jpg";

const toc = [
  ["answer", "Direct answer"],
  ["summary", "Summary"],
