---
/**
 * Terms of Use — the terms that govern use of the ALYRA website and the
 * enquiry and confidential-valuation services offered through it. Drafted in
 * the same plain-language register as the Privacy Policy. Loans themselves are
 * governed by their own written agreements, not these terms.
 *
 * `noticeNoun` is omitted so LegalPage suppresses the "being finalised" notice.
 */
import LegalPage from "../components/LegalPage.astro";
import { SITE } from "../config/site";
---

<LegalPage
  title="Terms of Use | ALYRA"
  heading="Terms of Use"
  crumbName="Terms"
  description="The terms that apply to use of the ALYRA website and enquiry services. General information only — not a loan offer or financial, legal or credit advice."
  path="/terms/"
  intro={[
    "This website provides general information about ALYRA's private asset-based lending. It does not constitute a loan offer, or financial, legal or credit advice.",
    "Any loan would be subject to its own written agreement and terms provided to you directly. ALYRA's full terms of use for this website are set out below.",
  ]}
>
  <div class="policy">
      <p class="legal-dateline">Effective date: 16 September 2026 · Last updated: 16 September 2026</p>

      <h2 class="legal-h2">1. About these Terms</h2>
      <p class="legal-p">These Terms of Use (“Terms”) apply to your access to and use of the website at alyra.com.au and any related pages, forms and content we make available through it (together, the “Website”).</p>
      <p class="legal-p legal-p--em">By accessing or using the Website, you agree to these Terms. If you do not agree, please do not use the Website.</p>
      <p class="legal-p">These Terms should be read together with our <a href="/privacy/">Privacy Policy</a>, which explains how we handle personal information, and our <a href="/complaints/">Complaints</a> page, which explains how to raise a concern with us.</p>
      <p class="legal-p">These Terms govern the Website only. They do not govern any loan, valuation, custody, purchase or other transaction with ALYRA. Those arrangements are governed by the separate written agreements and documents provided to you directly (see section 5).</p>

